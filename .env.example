SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Persistent disk on PaaS (keep SQLite and uploads off the ephemeral app dir)
SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media

# Set False only if the platform is HTTP during first bring-up
SECURE_SSL_REDIRECT=True

# Optional — only needed if the app starts sending email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
